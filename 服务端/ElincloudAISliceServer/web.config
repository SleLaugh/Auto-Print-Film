<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ElincloudServer.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache" />
          <add name="Access-Control-Allow-Methods" value="POST" />
          <add name="Access-Control-Allow-Headers" value="actionaddress,signature,timestamp,nonce,customtraceno,Origin,X-Test-Header,X-Requested-With,Content-Type,Accept,Token,LoginName,Access-Control-Allow-Headers,Access-Token,Authorization" />
          <add name="Access-Control-Max-Age" value="3600" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".dcm" mimeType="text/plain" />
    </staticContent>
    <security>
      <requestFiltering>
		<!--文件上传大小控制，默认是28.6M，不够，所以先放到300M-->
		<requestLimits maxAllowedContentLength="1000000000" />
        <fileExtensions>
          <add fileExtension=".pdf" allowed="false" />
          <add fileExtension=".dcm" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
<!--ProjectGuid: E1765026-4549-4DE8-9896-750002D2A426-->