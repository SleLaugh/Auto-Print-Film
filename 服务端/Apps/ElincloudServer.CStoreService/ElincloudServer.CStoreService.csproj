<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<BaseOutputPath>..\..\Bin</BaseOutputPath>
		<PackageOutputPath>$(OutputPath)</PackageOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<DebugType>none</DebugType>
		<!-- 禁用调试信息生成 -->
		<Nullable>enable</Nullable>
		<BaseOutputPath>..\..\Bin</BaseOutputPath>
		<PackageOutputPath>$(OutputPath)</PackageOutputPath>
	</PropertyGroup>

	<PropertyGroup>
	  <OutputType>WinExe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="fo-dicom.NetCore" Version="4.0.8" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="6.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\BLServices\ElincloudServer.ConfigBLService\ElincloudServer.ConfigBLService.csproj" />
		<ProjectReference Include="..\..\ElincloudServer.Common\ElincloudServer.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="ElincloudServer.Entity">
	    <HintPath>..\..\ElincloudAISliceServer.Libs\ElincloudServer.Entity.dll</HintPath>
	  </Reference>
	</ItemGroup>
</Project>
